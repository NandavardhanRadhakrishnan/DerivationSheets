<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="generator" content="{{.Product}}">
<link rel="icon" href="data:,">
<title>{{.Title}}</title>
<style>{{.CSS}}</style>
</head>
<body>
<header class="head">
  <div class="kicker">Flow · <code>{{.Slug}}</code> · version {{.Version}}</div>
  <h1>{{.Title}}</h1>
  <p class="meta">{{.Summary}}<span class="sep"> · </span>End-to-end sheet: <code>{{.SheetPath}}</code></p>
</header>

<div class="scroll">
<table class="flow">
  <thead>
    <tr>
      <th class="value">Value</th>
      {{range .Columns}}
      {{if .Boundary}}
      <th class="b-head" title="{{.Path}}">
        <div class="kind">{{.Kind}}</div>
        <div class="iname"><code>{{.Name}}</code></div>
        {{if .Owner}}<div class="owner">{{.Owner}}</div>{{end}}
        <div class="badges">
          <span class="badge {{.Status}}">{{.Status}}</span>
          {{if .Missing}}<span class="count missing">✕ {{.Missing}}</span>{{end}}
          {{if .Warnings}}<span class="count warning">⚠ {{.Warnings}}</span>{{end}}
        </div>
        {{if .Source}}<div class="source" title="{{.Source}}">{{.Source}}</div>{{end}}
      </th>
      {{else}}
      <th class="s-head">
        <div class="kind">{{.Kind}}</div>
        <div class="team">{{.Name}}</div>
      </th>
      {{end}}
      {{end}}
    </tr>
  </thead>
  {{range .Groups}}
  <tbody>
    <tr class="group"><th colspan="{{$.SpanAll}}">{{.Title}}</th></tr>
    {{range .Rows}}
    <tr>
      <td class="value"><div class="name">{{.Name}}</div><div class="id"><code>{{.ID}}</code></div></td>
      {{range .Cells}}<td class="{{if .Boundary}}b{{else}}s{{end}} {{.Class}}"{{if .Title}} title="{{.Title}}"{{end}}>{{.HTML}}</td>{{end}}
    </tr>
    {{end}}
  </tbody>
  {{end}}
</table>
</div>

{{if .Agenda}}
<section class="agenda">
  <h2>To agree</h2>
  <p class="hint">Grouped by the team that owns each interface. ✕ is a field the flow needs and the interface does not have; ⚠ is a field that exists but does not fit.</p>
  <div class="teams">
  {{range .Agenda}}
    <div class="team-block">
      <h3>{{.Team}}</h3>
      <ul>{{range .Items}}<li class="{{.Class}}"><span class="mark">{{.Mark}}</span> <code class="in">{{.Interface}}</code> {{.Text}}</li>{{end}}</ul>
    </div>
  {{end}}
  </div>
</section>
{{else}}
<section class="agenda"><h2>To agree</h2><p class="hint">Nothing: every boundary carries what the flow needs.</p></section>
{{end}}

{{if .Unused}}
<section class="unused-list">
  <h2>Fields this flow does not use</h2>
  <dl>{{range .Unused}}<dt><code>{{.Interface}}</code></dt><dd>{{.Fields}}</dd>{{end}}</dl>
</section>
{{end}}

<section class="legend">
  <h2>How to read this flow</h2>
  <dl>
    <dt>Shaded columns</dt><dd>Interfaces: API requests and responses, topics, events. The columns between them are the steps each team computes.</dd>
    <dt><code>field</code></dt><dd>The interface carries this value under that field. <span class="auto">≈</span> means it was matched by name rather than listed under <code>carries</code>.</dd>
    <dt class="missing">✕ add <code>field</code></dt><dd>The value must cross this boundary, but the interface has no field for it.</dd>
    <dt class="warning"><code>field</code> ⚠</dt><dd>The field exists but does not fit: optional when always needed, a different type, or values outside its enum.</dd>
    <dt class="unused"><code>field</code></dt><dd>Carried, but nothing after this point needs it.</dd>
    <dt>→ / ↷ kept</dt><dd>The value passes through a step, or the caller keeps it across a call instead of sending it.</dd>
  </dl>
</section>
<footer class="foot">Generated by {{.Product}} on {{.Generated}}. Each team's step is detailed in the end-to-end derivation sheet.</footer>
</body>
</html>
